{
  "name": "@dalerjig/safkit",
  "version": "0.3.32",
  "type": "module",
  "main": "./dist/shkit.cjs",
  "module": "./dist/shkit.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/shkit.js",
      "require": "./dist/shkit.cjs"
    }
  },
  "files": [
    "dist",
    "src/docs/components",
    "Changelog.MD"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.lib.json",
    "build_with_check": "npm run validate && npm run build",
    "validate": "tsc -b",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "csx": "^10.0.2",
    "dayjs": "^1.11.21",
    "typestyle": "^2.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource/rubik": "^5.2.8",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-checker": "^0.14.5"
  },
  "packageManager": "npm@11.6.1"
}
